# NEVER commit credentials — DATABASE_URI is read from the environment only
.env
.env.*
*.pem

# Data (the HF dump is gated; don't redistribute)
data/
*.jsonl.gz
*.jsonl
out/
sweeps/

# Generated pipeline output carries gated agent memory, goals, and chat.
artifacts/current/

# Golden labels also quote gated material. The episode identity manifest is a
# schema fixture and remains committed.
evaluation/goldens/stage1/
evaluation/goldens/stage2/*
!evaluation/goldens/stage2/episode_targets.json

# Rendered evaluation evidence and raw agent-days are reproducible from the
# gated dump, but must not be redistributed.
evaluation/evidence/

# Historical paid outputs remain local; archive notes and charts are tracked.
artifacts/archive/*/stage1/model_runs/
artifacts/archive/*/stage2/artifacts/

__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/
.DS_Store

# Local agent harness state (scheduled tasks from /loop) — not project content
.claude/

# pytest's cache; nothing in it is an input to anything
.pytest_cache/
